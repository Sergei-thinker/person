#!/usr/bin/env bash
set -Eeuo pipefail

cd "$(dirname "$0")"

if [ ! -d ".venv" ]; then
  python3.11 -m venv .venv
fi

source .venv/bin/activate

if [ ! -f ".venv/.deps_installed" ] || [ requirements.txt -nt .venv/.deps_installed ]; then
  pip install -r requirements.txt
  touch .venv/.deps_installed
fi

if [ -f ".env" ]; then
  set -a
  source .env
  set +a
fi

exec python -m app.main



